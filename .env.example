# Copy to `.env.local` and fill in the values.

# --- Database (Neon) ---
DATABASE_URL=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=

# --- Sentry (error & performance monitoring) ---
# DSN of your Sentry project. Safe to expose to the browser (write-only).
NEXT_PUBLIC_SENTRY_DSN=

# Used at build time to upload source maps. Set these in Vercel (Production scope).
# The auth token is a secret — never commit it.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Note: `enabled` is gated on VERCEL_ENV / NEXT_PUBLIC_VERCEL_ENV === "production",
# which Vercel injects automatically. Events are only sent from production, so
# these Sentry values are not required for local development.
